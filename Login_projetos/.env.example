# ============================================================================
# Login_projetos — variáveis de ambiente
#
# Copie este arquivo como `.env` na raiz do SEU projeto (o que vai usar o
# módulo) e preencha os valores. No Vite, só variáveis com o prefixo VITE_
# chegam ao navegador.
#
# NUNCA coloque aqui a `DATABASE_URL` (string de conexão do Postgres) nem
# qualquer senha: estas variáveis vão para o bundle do navegador. A URL abaixo
# é pública e o que protege os dados é o RLS no banco.
# ============================================================================

# URL HTTPS do banco no Neon (host + database) — a mesma que o Data API usa.
# Serve para Auth E para as consultas. Exemplo:
#   VITE_NEON_URL=https://ep-xxxxx.c-2.us-east-2.aws.neon.tech/neondb
VITE_NEON_URL=

# URL pública do app para links de recuperação enviados por e-mail (opcional).
# Sem ela, o módulo usa a origem atual do navegador.
VITE_APP_URL=

# Cadastro público. `false` esconde o link "Criar conta" e bloqueia a tela.
VITE_CADASTRO_PUBLICO=true
